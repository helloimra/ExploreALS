    "NCT05193994": {
      "title": "Triumeq in Amyotrophic Lateral Sclerosis",
      "status": "TERMINATED",
      "why_stopped": "A planned interim analysis resulted in the recommendation that the trial be stopped. The results showed no benefit of Triumeq for people with ALS compared with placebo on survival, the primary outcome measure.",
      "completion_date": "2025-06-30",
      "enrollment": 419
    },
    "NCT06658977": {
      "title": "RolloverTreatment With Triumeq for People With ALS Following the Lighthouse II Trial",
      "status": "TERMINATED",
      "why_stopped": "This is a rollover study following the Lighthouse II trial; it was scheduled to stop when the LH II trial was stopped/completed. The LH II trial has been prematurely terminated so, likewise, this study has also now been stopped.",
